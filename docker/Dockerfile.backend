FROM node:20

WORKDIR /app

COPY package*.json ./

RUN npm cache clean --force

RUN npm install

COPY . .

ENV NODE_ENV=production

ENV MONGO_URI=""
ENV REDIS_HOST=""
ENV REDIS_PORT=""
ENV CLOUDINARY_CLOUD_NAME=""
ENV CLOUDINARY_API_KEY=""
ENV CLOUDINARY_API_SECRET=""
ENV JWT_SECRET=""
ENV GOOGLE_CLIENT_ID=""


EXPOSE 4000

CMD ["npm", "start"]